# Copy to .env for local public configuration. Do not put seed phrases or
# private keys in this file.

CLUSTER=devnet
# Backward-compatible alias. Prefer CLUSTER.
# SOLANA_CLUSTER=devnet

# Optional custom RPC URL. Leave empty to use the cluster default.
RPC_URL=

OWNER_KEYPAIR=./keys/owner.json
MINT_KEYPAIR=./keys/mint-350meme.json

# Solana addresses are base58. The digit 0 is invalid, so literal 350M is
# impossible. Use a valid suffix such as 35M, 35, or 35oM.
VANITY_SUFFIX=35M
MAX_VANITY_ATTEMPTS=5000000

TOKEN_NAME=350Meme
TOKEN_SYMBOL=350M
TOKEN_DESCRIPTION=350Meme: a fixed-supply Solana meme token with exactly 350 whole tokens.
TOKEN_LOGO_URI=https://example.com/350meme-logo.png
TOKEN_METADATA_URI=https://example.com/350meme.json
TOKEN_EXTERNAL_URL=https://example.com/350meme
TOKEN_SUPPLY=350
TOKEN_DECIMALS=0

# Mainnet guard. Keep false unless you are intentionally deploying to mainnet.
CONFIRM_MAINNET=false
REVOKE_AFTER_MINT=true
